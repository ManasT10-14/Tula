{
  "id": "LMPCR.R6.1.F.UNIT_PRICE_ARITHMETIC",
  "title": "Declared unit sale price is arithmetically correct",
  "plain": "The price per unit is calculated correctly",
  "plain_action": "Divide the MRP by the net quantity and compare with the printed unit price, using the basis the Rules prescribe for that size.",
  "citation": {
    "clause": "Rule 6(11), including its provisos",
    "text": "Screening paraphrase: declare the applicable unit price using the prescribed gram/kilogram, centimetre/metre, millilitre/litre or count basis, subject to the equal-price, State-excise and package-structure exceptions."
  },
  "effective_from": "2024-01-01",
  "declaration": "unit_sale_price",
  "applies_when": {
    "all": [
      {
        "present": "$decl.unit_sale_price.norm.value"
      },
      {
        "present": "$decl.retail_sale_price.norm.value"
      },
      {
        "present": "$decl.net_quantity.norm.value_base"
      }
    ]
  },
  "assert": {
    "legal_screen": {
      "kind": "unit_price",
      "exempt_bundles": [
        "combination",
        "group",
        "multipiece"
      ],
      "bases": {
        "g": {
          "boundary": 1000,
          "small": 1,
          "large": 1000
        },
        "ml": {
          "boundary": 1000,
          "small": 1,
          "large": 1000
        },
        "cm": {
          "boundary": 100,
          "small": 1,
          "large": 100
        },
        "N": {
          "small": 1
        }
      }
    }
  },
  "severity": "major",
  "min_assurance_tier": "C",
  "penalty_ref": "LM Act 2009 s.36(1)",
  "messages": {
    "pass": "The printed unit price uses the prescribed denominator and matches Decimal arithmetic rounded to two places.",
    "violation": "The declared unit price uses an incorrect statutory denominator or does not match the declared MRP and net quantity.",
    "inconclusive": "Unit-price applicability, units or arithmetic require review."
  },
  "evidence": [
    "unit_sale_price",
    "net_quantity",
    "retail_sale_price"
  ],
  "tests": "tests/test_rules_engine.py",
